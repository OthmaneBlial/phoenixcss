{
  "name": "phoenixcss",
  "version": "1.0.0",
  "description": "A Minimal CSS Framework for Semantic HTML",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "dist/css/phoenix.css",
  "scripts": {
    "build:css": "node scripts/build.mjs",
    "watch:css": "sass --watch --no-source-map src/sass/_index.scss:dist/css/phoenix.css src/sass/core.scss:dist/css/phoenix.core.css",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "site": "npm run build && npm run build:site",
    "measure": "node scripts/measure.mjs --build",
    "measure:compare": "node scripts/measure.mjs --build --compare",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:site": "node scripts/check-site.mjs",
    "lint:html": "html-validate \"docs/**/*.html\" \"examples/**/*.html\"",
    "lint": "prettier --check \"src/sass/**/*.scss\" \"examples/**/*.{html,css,js}\" \"docs/**/*.{html,css,js,md}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" README.md package.json playwright.config.mjs .htmlvalidate.json && npm run lint:html",
    "format": "prettier --write \"src/sass/**/*.scss\"",
    "dev": "npm run watch:css",
    "test": "npm run site && npm run check:css && npm run check:contrast && npm run check:site && node --test tests/*.test.mjs",
    "test:browser": "npm run site && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "cssnano": "^7.0.6",
    "html-validate": "11.16.0",
    "postcss": "^8.5.28",
    "prettier": "^3.3.3",
    "sass": "^1.77.8"
  },
  "keywords": [
    "css",
    "framework",
    "minimal",
    "semantic",
    "responsive"
  ],
  "author": "Othmane BLIAL",
  "license": "MIT"
}
